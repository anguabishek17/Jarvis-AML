# ==============================================================================
# JARVIS-AML ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env for local overrides or configure in your deployment dashboard:
# - Backend (Render): configure FRONTEND_ORIGIN
# - Frontend (Vercel): configure VITE_API_BASE_URL

# Backend CORS Allowed Origin (Vercel Frontend URL or multiple comma-separated origins)
# Example for production: FRONTEND_ORIGIN=https://jarvis-aml.vercel.app
# Example for multiple: FRONTEND_ORIGIN=https://jarvis-aml.vercel.app,http://localhost:5173
FRONTEND_ORIGIN=http://127.0.0.1:8089,http://localhost:5173

# Frontend Backend API Base URL
# Local Development: http://127.0.0.1:8089
# Production on Render: https://jarvis-aml-backend.onrender.com
VITE_API_BASE_URL=http://127.0.0.1:8089
